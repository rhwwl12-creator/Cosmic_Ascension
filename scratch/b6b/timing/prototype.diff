 		return Table ? Table->FindRow<RowType>(RowName, TEXT("FCosmicDataTables"), false) : nullptr;
 	}
+
+	// The sorted row names of a table, remembered with the key sequence they were made from (RowMap iteration order,
+	// compared case-sensitively with the number). The sorted list is a function of that sequence alone, so a table that
+	// gained, lost or renamed a row - or another table - is sorted again; the array handed out is the same.
+	struct FSortedNamesMemo
+	{
+		TArray<FName> Keys;
+		TArray<FName> Sorted;
+		bool bValid = false;
+	};
+
+	bool SameKeySequence(const UDataTable* Table, const TArray<FName>& Keys)
+	{
+		const TMap<FName, uint8*>& RowMap = Table->GetRowMap();
+		if (RowMap.Num() != Keys.Num())
+		{
+			return false;
+		}
+		int32 At = 0;
+		for (const TPair<FName, uint8*>& Row : RowMap)
+		{
+			if (!Row.Key.IsEqual(Keys[At], ENameCase::CaseSensitive, true))
+			{
+				return false;
+			}
+			++At;
+		}
+		return true;
+	}
+
+	TArray<FName> SortedRowNamesOf(const UDataTable* Table, FSortedNamesMemo& Memo)
+	{
+		if (!Table)
+		{
+			return TArray<FName>();
+		}
+		if (!Memo.bValid || !SameKeySequence(Table, Memo.Keys))
+		{
+			Memo.Keys.Reset();
+			for (const TPair<FName, uint8*>& Row : Table->GetRowMap())
+			{
+				Memo.Keys.Add(Row.Key);
+			}
+			Memo.Sorted = Table->GetRowNames();
+			Memo.Sorted.Sort(FNameLexicalLess());
+			Memo.bValid = true;
+		}
+		return Memo.Sorted;
+	}
 }
 
