diff --git a/Source/Cosmic_Ascension/Core/CosmicAIProbe.h b/Source/Cosmic_Ascension/Core/CosmicAIProbe.h
new file mode 100644
index 0000000..f1fc036
--- /dev/null
+++ b/Source/Cosmic_Ascension/Core/CosmicAIProbe.h
@@ -0,0 +1,144 @@
+// TEMPORARY timing probe for the G1 gate (SAND only - never committed).
+// Laps inside the AI stage, call counters in the table primitives, and a census. Reads the clock only; no state, no draw.
+#pragma once
+
+#include "CoreMinimal.h"
+#include "HAL/PlatformTime.h"
+
+namespace CosmicAIProbe
+{
+	enum EBlock : int32
+	{
+		BChoices,
+		BSettle,
+		BRevoke,
+		BLaws,
+		BTreaty,
+		BTreatyPartner,
+		BDiplomacy,
+		BAim,
+		BFeats,
+		BBrake,
+		BJudgeRows,
+		BPrimFeatNames,
+		BPrimHazardByTag,
+		BPrimHazardAnswer,
+		BPrimEdictNames,
+		BNum
+	};
+	enum ECount : int32
+	{
+		CFeatNames,
+		CHazardNames,
+		CEdictNames,
+		CEventNames,
+		CHazardAnswer,
+		CHazardByTag,
+		CFindFeat,
+		CFindEdict,
+		CFindHazard,
+		CFindProject,
+		CFindGalaxy,
+		CFindTrans,
+		CFindArch,
+		CFindEvent,
+		CAsksTreatyCall,
+		CAsksTreatyTrue,
+		CPartnerCands,
+		CMarkNeighbours,
+		CAimCall,
+		CAimScan,
+		CAimSiegeChecks,
+		CAsksLawsCall,
+		CAsksLawsTrue,
+		CEnactBlock,
+		CJudgeCall,
+		CJudgeBraked,
+		CJudgeCheckAll,
+		CChoicesCall,
+		CChoicesCapital,
+		CStartBlock,
+		CNum
+	};
+	enum EStage : int32
+	{
+		SNone,
+		SCrisis,
+		SAI,
+		SNum
+	};
+	inline int32 GLevel = 0;      // -AIProbe=<n>: 1 laps and counts, 2 also the primitives' own laps
+	inline int32 GStage = SNone;  // the stage the tick is in (crisis, AI), for the counters
+	inline uint64 GCycles[BNum] = {};
+	inline int64 GHits[BNum] = {};
+	inline int64 GCount[SNum][CNum] = {};
+	inline int64 GTierTicks[5] = {};
+	inline int64 GT3BareTicks = 0;
+	inline int64 GTreatyReason[16] = {};
+
+	inline void Reset()
+	{
+		FMemory::Memzero(GCycles);
+		FMemory::Memzero(GHits);
+		FMemory::Memzero(GCount);
+		FMemory::Memzero(GTierTicks);
+		GT3BareTicks = 0;
+		FMemory::Memzero(GTreatyReason);
+	}
+	FORCEINLINE bool On()
+	{
+		return GLevel > 0;
+	}
+	FORCEINLINE uint64 Now()
+	{
+		return GLevel > 0 ? FPlatformTime::Cycles64() : 0;
+	}
+	FORCEINLINE void Lap(int32 B, uint64& L)
+	{
+		if (GLevel > 0)
+		{
+			const uint64 N = FPlatformTime::Cycles64();
+			GCycles[B] += N - L;
+			++GHits[B];
+			L = N;
+		}
+	}
+	struct FScope
+	{
+		int32 B;
+		bool bActive;
+		uint64 T0;
+		explicit FScope(int32 In, bool bIn = true)
+			: B(In), bActive(bIn && GLevel > 0), T0(bActive ? FPlatformTime::Cycles64() : 0)
+		{
+		}
+		~FScope()
+		{
+			if (bActive)
+			{
+				GCycles[B] += FPlatformTime::Cycles64() - T0;
+				++GHits[B];
+			}
+		}
+	};
+	// A primitive's own lap: only at level 2 and only inside the AI stage.
+	struct FPrimScope : public FScope
+	{
+		explicit FPrimScope(int32 In)
+			: FScope(In, GLevel >= 2 && GStage == SAI)
+		{
+		}
+	};
+	FORCEINLINE void Count(int32 C)
+	{
+		if (GLevel > 0)
+		{
+			++GCount[GStage][C];
+		}
+	}
+	FORCEINLINE bool CountTrue(int32 C)
+	{
+		Count(C);
+		return true;
+	}
+}
