+	int64 JudgeReplica(const FGalaxyState& State, const FCosmicStateIndex& Index, const FCosmicDataTables& Tables, const FCosmicRulesDef& Rules, int32 CivIndex)
+	{
+		TArray<int32, TInlineAllocator<8>> Settled;
+		for (const FName SystemID : State.Civs[CivIndex].OwnedSystems)
+		{
+			const int32 SystemIndex = Index.FindSystem(State, SystemID);
+			if (State.Systems.IsValidIndex(SystemIndex) && State.Systems[SystemIndex].OwnerCivID == State.Civs[CivIndex].CivID && CosmicState::IsSettled(State.Systems[SystemIndex]))
+			{
+				Settled.Add(SystemIndex);
+			}
+		}
+		if (Settled.IsEmpty())
+		{
+			return 0;
+		}
+		if (State.Civs[CivIndex].Tier == EAscensionTier::Tier3_Causal && !CosmicAscent::FourthRungOpenOf(State, Tables, State.Civs[CivIndex].GalaxyRow))
+		{
+			return 1;
+		}
+		int64 Out = 2;
+		for (const FName FeatRow : Tables.GetFeatRowNames())
+		{
+			const FAscensionFeatDef* Feat = Tables.FindFeat(FeatRow);
+			const EAscensionTier Tier = State.Civs[CivIndex].Tier;
+			if (!Feat || !Feat->IsJudgedRulerRowAt(Tier))
+			{
+				continue;
+			}
+			for (const int32 SystemIndex : Settled)
+			{
+				FCosmicEvalView View(State, Index, Tables, Rules);
+				View.CivIndex = CivIndex;
+				View.SystemIndex = SystemIndex;
+				View.GalaxyRow = State.Civs[CivIndex].GalaxyRow;
+				View.SourceRow = FeatRow;
+				View.SinceTick = 0;
+				Out += UCosmicEventSubsystem::CheckAll(Feat->CompletionConditions, View) ? 10 : 3;
+			}
+		}
+		return Out;
+	}
+
+	int64 LawsReplica(const FGalaxyState& State, const FCosmicStateIndex& Index, const FCosmicDataTables& Tables, const FCosmicRulesDef& Rules, int32 CivIndex)
+	{
+		int64 Out = 0;
+		if (CosmicEdicts::AsksForLawsOf(State.Civs[CivIndex], Tables))
+		{
+			for (const FName Law : CosmicEdicts::GalaxyLawRowsOf(Tables))
+			{
+				const FEdictDef* Def = Tables.FindEdict(Law);
+				Out += (Def && CosmicEdicts::EnactBlockOf(State, Index, Tables, Rules, CivIndex, Law) == CosmicEdicts::ECosmicEdictBlock::None) ? 3 : 1;
+			}
+		}
+		return Out;
+	}
