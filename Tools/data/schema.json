{
	"version": 1,
	"about": [
		"Definition schema of Cosmic Ascension (guideline.md section 7.3, 9.3 Data.Integrity, 10.4).",
		"Authoring time only: nothing here reaches a runtime struct, the hash or a save.",
		"Checked by Tools/cosmic_data_schema.py before Tools/make_data_tables.py touches an asset (python Tools/check_data.py runs the same check without the editor), and by the automation test Cosmic_Ascension.Data.Integrity: this file against the code, the loaded assets against this file.",
		"The checker reads this file first. While it has a problem the data is not looked at.",
		"Every column of a row struct is declared here: a column added to a struct needs its line.",
		"Column kinds (closed list): plain, number, numbers, text, texts, tag, tags, tag_list, tag_map, row, row_map, rows, word_map, enum, conditions, effects, pool, structs",
		"An integer property is declared with integer: true (Data.Integrity holds the columns to the property types).",
		"Row tests (closed list): is, in, gt, ge, lt, le, set, min_len, max_len, each_contains, lacks_type, has_type, slots_in, len_ge_col, pairs_ge_col, contains_all",
		"A row rule is 'when -> then' over tests: one column with one test of the list above, or 'row' with a row name. Each test can be asked of some kinds of column only (the checker holds the table).",
		"A column of a list of structs (kind structs) is named in a rule as 'List.Column': the test holds when it holds for every entry of the list, and so for an empty list. The tests that name other columns of the row (len_ge_col, pairs_ge_col) are not asked of such a column.",
		"A rule added here needs an input that breaks it in Tools/test_data_schema.py: that test walks every rule, unique, pair, target and slot list of this file.",
		"A number range stands here only where the guideline states one. A column without a range is checked for being a finite number.",
		"The keys of this file and the options of each kind are closed lists in the checker, each with the type of its value: a key nothing reads or a value of the wrong type is a problem, so a slip cannot switch a check off.",
		"What a rule names has to exist: a test over a column the table does not declare, a tag the ini lacks, a name that is no enumerator or a row the table neither requires nor has is a problem (it would never hold).",
		"required_rows are the rows the code calls by name: the checker holds them, both ways, to the names in the headers under row_name_sources. A table that has an asset carries must_exist.",
		"A table whose columns are null has no rows yet: its columns are declared when its first row is written."
	],
	"tag_sources": ["Config/DefaultGameplayTags.ini"],
	"row_name_sources": ["Source/Cosmic_Ascension/Data/CosmicRowNames.h"],
	"required_tags": ["Notable.Ruler", "Notable.Regent", "Notable.Rebel", "Notable.Loyalist", "Notable.Hearer", "Notable.Ascendant"],
	"row_name_pattern": "^[a-z][a-z0-9_]*$",

	"words": {
		"resource": ["Energy", "Matter", "Insight", "Influence", "Causality"],
		"axis": ["Pacifism", "Spiritualism", "Openness"],
		"stat": ["Body", "Mind", "Causality", "Exaltation"],
		"role": ["Ruler", "Wanderer"],
		"civ_selector": ["Former"],
		"policy": ["Cautious", "Reckless", "Faithful", "Tribute"],
		"research": ["Physics", "Society", "Engineering", "Transcendence"],
		"verdict": ["천국", "지옥", "구원받", "멸망받", "영혼", "저주받", "심판받"],
		"other_works": [],
		"holy_and_myth": []
	},

	"string_table": {
		"checked_prefixes": {
			"Chronicle.": {"forbidden": "verdict", "no_digits": true},
			"Save.": {"forbidden": "verdict", "no_digits": true},
			"Hint.": {"forbidden": "verdict", "no_digits": true},
			"Galaxy.Hint": {"forbidden": "verdict", "no_digits": true},
			"Focus.": {"forbidden": "verdict", "no_digits": true}
		}
	},

	"enums": {
		"EAscensionTier": ["Tier1_Planetary", "Tier2_Stellar", "Tier3_Causal", "Tier4_Transcendent", "Tier5_EternalOrder"],
		"EPlayerRole": ["Ruler", "Wanderer"],
		"ECosmicEventTrigger": ["Lottery", "Standing", "Named"],
		"ECosmicEventSubject": ["Civilization", "SettledSystem"],
		"ECosmicHazardSpawn": ["Draw", "Capital", "ClaimRule"],
		"ECosmicCheckStat": ["NoCheck", "Body", "Mind", "Causality", "Exaltation", "Stability"]
	},

	"single_variant_rows": ["log_first_life", "log_first_contact"],

	"event_log_categories": {
		"Event.Civ.Economy": ["Log.Civ"],
		"Event.Civ.Society": ["Log.Civ"],
		"Event.Crisis.Supernova": ["Log.Crisis", "Log.Civ"],
		"Event.Crisis.Rebellion": ["Log.Crisis", "Log.Civ"],
		"Event.Crisis.Transcendent": ["Log.Transcendent", "Log.Crisis"],
		"Event.Crisis.Claim": ["Log.Claim", "Log.Record", "Log.Crisis"],
		"Event.Grace.Rescue": ["Log.Calling"],
		"Event.Grace.Remnant": ["Log.Civ"],
		"Event.Grace.Jubilee": ["Log.Civ"]
	},

	"tables": {
		"DT_Rules": {
			"struct": "CosmicRulesDef",
			"names": ["rules"],
			"must_exist": true,
			"required_rows": ["rules"],
			"columns": {
				"LeapTicksMin": {"kind": "number", "integer": true},
				"LeapTicksMax": {"kind": "number", "integer": true},
				"LeapTotalCap": {"kind": "number", "integer": true},
				"BirthProtectionTicks": {"kind": "number", "integer": true},
				"BaseLifespanTicks": {"kind": "number", "integer": true},
				"SuccessionHazardWeight": {"kind": "number"},
				"SuccessionCivTierWeight": {"kind": "number"},
				"SuccessionReverenceWeight": {"kind": "number"},
				"SuccessionReverenceThreshold": {"kind": "number"},
				"SuccessionSameCivPenalty": {"kind": "number"},
				"SuccessionMinHazardTicks": {"kind": "number", "integer": true},
				"ReverenceDecay": {"kind": "number"},
				"AIAscensionSpeedMultiplier": {"kind": "number"},
				"PostRebellionStability": {"kind": "number"},
				"ThroneLockTicks": {"kind": "number", "integer": true},
				"PressureBySourceTier": {"kind": "numbers", "len": 5, "min": 0},
				"PressureAdjacencyFalloff": {"kind": "number", "min": 0, "max": 1},
				"SpiritualPressureStabilityDrain": {"kind": "number", "min": 0},
				"PressureFleetAttrition": {"kind": "number"},
				"FleetEffectivenessByTierGap": {"kind": "numbers", "len": 3},
				"FleetDelayPerPower": {"kind": "number"},
				"FleetDelayCap": {"kind": "number"},
				"ImmutableLaws": {"kind": "tags", "root": "Law."},
				"FallenTranscendentCount": {"kind": "number", "min": 0, "max": 3, "integer": true},
				"PlayerArchetypeRow": {"kind": "row", "table": "DT_Civs"},
				"ClaimAdjacencyLanes": {"kind": "number", "integer": true},
				"VigilClaimExtension": {"kind": "number", "integer": true},
				"SphereEventWeightStep": {"kind": "number", "min": 0},
				"ReturnLureMaxLanes": {"kind": "number", "integer": true},
				"ReturnedLivesToSeize": {"kind": "number", "integer": true},
				"LureAcceptByPolicy": {"kind": "word_map", "words": "policy"},
				"MaxNotablesPerCiv": {"kind": "number", "min": 3, "max": 5, "integer": true},
				"PopulationBandThresholds": {"kind": "numbers", "len": 3, "ascending": true},
				"PopulationRegrowthPerTick": {"kind": "number", "min": 0},
				"EventSlotTicks": {"kind": "number", "min": 1, "max": 20, "integer": true},
				"EventChancePerSlot": {"kind": "number", "min": 0},
				"HomeGalaxyRow": {
					"kind": "row",
					"table": "DT_Galaxies",
					"target": [
						{"col": "BridgeTicks", "is": 0},
						{"col": "LivingWorlds", "ge": 1},
						{"col": "Peoples", "ge": 1},
						{"col": "StarNameBank", "len_ge_col": "Peoples"},
						{"col": "CatalogPrefixes", "pairs_ge_col": ["CatalogStems", "LivingWorlds"]}
					]
				},
				"RealmCapByTier": {"kind": "numbers", "len": 5, "ascending": true, "integer": true},
				"SightLanesByTier": {"kind": "numbers", "len": 5, "min": 1, "integer": true},
				"SightIntervalTicks": {"kind": "number", "min": 1, "integer": true},
				"FirstSightTick": {"kind": "number", "min": 0, "integer": true},
				"FarLineCooldownTicks": {"kind": "number", "min": 0, "integer": true},
				"LivingWorldStarShares": {"kind": "numbers", "len": 7, "ascending": true, "min": 0, "max": 1, "ends_at": 1},
				"FallenCoreMinLanesFromHome": {"kind": "number", "integer": true},
				"BackgroundStarCount": {"kind": "number", "min": 0, "max": 100000, "integer": true},
				"SceneryGalaxyCount": {"kind": "number", "min": 0, "max": 50000, "integer": true},
				"PetitionPeriodTicks": {"kind": "number", "min": 1, "integer": true},
				"StabilityRecoveryPerTick": {"kind": "number", "min": 0, "max": 1},
				"StabilityRestingLevel": {"kind": "number", "min": 0, "max": 1},
				"ClaimLeaveProfiles": {"kind": "tags", "root": "AI.Profile."},
				"FirstCrisisTick": {"kind": "number", "min": 0, "integer": true},
				"FirstCrisisHazard": {"kind": "tag", "root": "Hazard.", "optional": true},
				"ProvisionalEndTick": {"kind": "number", "min": 0, "integer": true},
				"ChronicleCap": {"kind": "number", "min": 0, "integer": true},
				"ResearchFocusShare": {"kind": "number", "min": 0.3, "max": 1},
				"TierMultiplier": {"kind": "numbers", "len": 5, "min": 0},
				"MaterialistEnergyBonus": {"kind": "number", "min": 0},
				"InsightPerPopulation": {"kind": "number", "min": 0},
				"SpiritualistInsightBonus": {"kind": "number", "min": 0},
				"InfluencePerPopulation": {"kind": "number", "min": 0},
				"OpenInfluenceBonus": {"kind": "number", "min": 0},
				"ResearchInsightShare": {"kind": "number", "min": 0, "max": 1},
				"ResearchPerInsight": {"kind": "number", "min": 0}
			},
			"rules": [
				{
					"why": "the rate of the AI's projects multiplies their progress: at 0 or below they would never progress, so the code reads it as 1 with an error line (guideline 4.3, 5.7)",
					"then": [{"col": "AIAscensionSpeedMultiplier", "gt": 0}]
				},
				{
					"why": "the first life is born into the first life's row, arch_seeker (guideline 5.10)",
					"then": [{"col": "PlayerArchetypeRow", "is": "arch_seeker"}]
				},
				{
					"why": "every immutable law the rules read is listed, and none can be taken out of the list: Law.Hedge keeps the sanctuary (guideline 4.5)",
					"then": [{"col": "ImmutableLaws", "contains_all": ["Law.Judgment", "Law.Sabbath", "Law.Humility", "Law.Remnant", "Law.Hedge"]}]
				}
			]
		},

		"DT_Civs": {
			"struct": "CivArchetypeDef",
			"prefixes": ["arch_"],
			"must_exist": true,
			"required_rows": ["arch_default", "arch_seeker"],
			"columns": {
				"DisplayName": {"kind": "text"},
				"Traits": {"kind": "tags", "root": "Trait."},
				"EthicsPreset": {"kind": "plain"},
				"AIProfile": {"kind": "tag", "root": "AI.Profile.", "optional": true},
				"Color": {"kind": "plain"},
				"NameBank": {"kind": "texts", "slots": ["Star"], "no_digits": true, "forbidden": "verdict"},
				"AdjectiveBank": {"kind": "texts", "len_in": [0, 3], "slots": [], "forbidden": "verdict"},
				"PersonNameBank": {"kind": "texts", "empty_or_min": 10, "unique": true, "slots": [], "forbidden": "verdict"},
				"HazardSpawnMultipliers": {"kind": "tag_map", "root": "Hazard.", "min": 0},
				"InitialRelations": {"kind": "row_map", "table": "DT_Civs", "min": -1, "max": 1, "target": [{"col": "Weight", "gt": 0}]},
				"Weight": {"kind": "number", "min": 0},
				"RevelationMode": {"kind": "tag", "root": "Revelation."},
				"RevelationTemplates": {"kind": "texts", "len_in": [1, 3]},
				"HomeSystemNames": {"kind": "texts", "slots": [], "no_digits": true, "forbidden": "verdict"},
				"HomeStarClass": {"kind": "tag", "root": "Star.Class.", "optional": true},
				"DedicationBanks": {"kind": "tag_list", "root": "Faith.Bank."}
			},
			"rules": [
				{
					"why": "the name pattern of a people drawn for the AI calls its home star (guideline 5.11)",
					"when": [{"col": "Weight", "gt": 0}],
					"then": [{"col": "NameBank", "min_len": 1}, {"col": "NameBank", "each_contains": "{Star}"}]
				},
				{
					"why": "the home of a people drawn for the AI takes a proper name from the galaxy without replacement, never a fixed one two peoples could share (guideline 7.4)",
					"when": [{"col": "Weight", "gt": 0}],
					"then": [{"col": "HomeSystemNames", "max_len": 0}]
				},
				{
					"why": "the first life's row is a seeking people no AI people is drawn from: weight 0, its archetype tag, the seeking revelation (guideline 5.10, 5.11)",
					"when": [{"row": "arch_seeker"}],
					"then": [{"col": "Weight", "is": 0}, {"col": "Traits", "contains_all": ["Trait.Arch.Seeker"]}, {"col": "RevelationMode", "is": "Revelation.Seeking"}]
				}
			]
		},

		"DT_LogTemplates": {
			"struct": "LogTemplateDef",
			"prefixes": ["log_"],
			"must_exist": true,
			"required_rows": ["log_first_life", "log_breakthrough_physics", "log_breakthrough_society", "log_breakthrough_engineering", "log_breakthrough_transcendence", "log_fallen_monarch", "log_first_contact", "log_contact", "log_far_event", "log_far_ascent"],
			"columns": {
				"Category": {"kind": "tag", "root": "Log."},
				"Context": {"kind": "tag", "root": "Revelation.", "optional": true},
				"MinTierToReveal": {"kind": "number", "min": 0, "max": 5, "integer": true},
				"Templates": {
					"kind": "texts",
					"min": 3,
					"single_variant": true,
					"slots": ["Civ", "System", "OtherCiv", "Trait", "Value", "Tier", "Hazard", "Player", "HomeSystem", "Dedication", "Epithet", "Revelation", "Transcendent", "Ruler", "Regent", "Rebel", "Loyalist", "Hearer", "Ascendant", "PopBand", "CivAdj"],
					"forbidden": "verdict"
				}
			},
			"unique": [
				{"cols": ["Category", "Context"], "when": [{"col": "Context", "set": true}], "why": "at most one selector row per category and revelation mode"}
			],
			"rules": [
				{
					"why": "the calling's own line is told whatever its subject, and no tier window hides it: a line of the calling that waits for a tier is an event row with its sign row (guideline 8.1)",
					"when": [{"col": "Category", "is": "Log.Calling"}],
					"then": [{"col": "MinTierToReveal", "is": 0}]
				},
				{
					"why": "a far line is the same sentence for everyone, told with no subject and no arguments, and the clock of the race stops when a window hides it: log_far_event (guideline 8.1)",
					"when": [{"row": "log_far_event"}],
					"then": [{"col": "Category", "is": "Log.Discovery"}, {"col": "MinTierToReveal", "is": 0}, {"col": "Templates", "slots_in": []}]
				},
				{
					"why": "a far line is the same sentence for everyone, told with no subject and no arguments, and the clock of the race stops when a window hides it: log_far_ascent (guideline 8.1)",
					"when": [{"row": "log_far_ascent"}],
					"then": [{"col": "Category", "is": "Log.Discovery"}, {"col": "MinTierToReveal", "is": 0}, {"col": "Templates", "slots_in": []}]
				}
			]
		},

		"DT_Events": {
			"struct": "CosmicEventDef",
			"prefixes": ["event_"],
			"must_exist": true,
			"required_rows": ["event_book_found", "event_grace_remnant"],
			"columns": {
				"Category": {"kind": "tag", "root": "Event."},
				"LogCategory": {"kind": "tag", "root": "Log."},
				"Trigger": {"kind": "enum", "enum": "ECosmicEventTrigger"},
				"Subject": {"kind": "enum", "enum": "ECosmicEventSubject"},
				"Conditions": {"kind": "conditions"},
				"BaseWeight": {"kind": "number", "min": 0},
				"CooldownTicks": {"kind": "number", "min": 0, "integer": true},
				"Effects": {"kind": "effects"},
				"LogTemplates": {"kind": "texts", "slots": ["Civ", "System", "Hazard"], "forbidden": "verdict"},
				"Severity": {"kind": "number", "min": 0, "max": 2, "integer": true},
				"MinTierToReveal": {"kind": "number", "min": 0, "max": 5, "integer": true},
				"SignRow": {
					"kind": "row",
					"table": "DT_LogTemplates",
					"optional": true,
					"target": [{"col": "Category", "is": "Log.Sign"}, {"col": "Templates", "slots_in": ["Civ", "Hazard"]}]
				}
			},
			"pairs": [
				{"key": "Category", "value": "LogCategory", "allowed": "event_log_categories", "why": "the log category an event category may tell (guideline 8.1)"}
			],
			"rules": [
				{
					"why": "the subject system of a line is the system it names: a Civilization row is about the people alone and names no system, so the name of a system the calling does not know never reaches the feed (guideline 8.1)",
					"when": [{"col": "Subject", "is": "Civilization"}],
					"then": [{"col": "LogTemplates", "slots_in": ["Civ", "Hazard"]}]
				},
				{
					"why": "a slot row tells with three variants or more (guideline 8.2)",
					"when": [{"col": "Trigger", "in": ["Lottery", "Standing"]}],
					"then": [{"col": "LogTemplates", "min_len": 3}]
				},
				{
					"why": "a row fired by name tells with one variant or more (guideline 8.2)",
					"when": [{"col": "Trigger", "is": "Named"}],
					"then": [{"col": "LogTemplates", "min_len": 1}]
				},
				{
					"why": "a slot runs for every people: until the selector words reach the code (Phase 4 petitions) it carries no condition on the vessel, no role effect and no effect on the vessel (guideline 16 #29 (7))",
					"when": [{"col": "Trigger", "in": ["Lottery", "Standing"]}],
					"then": [
						{"col": "Conditions", "lacks_type": "PlayerTierAtLeast"},
						{"col": "Conditions", "lacks_type": "PlayerInSystemWithHazard"},
						{"col": "Conditions", "lacks_type": "PlayerStatAtLeast"},
						{"col": "Conditions", "lacks_type": "PlayerHasRelic"},
						{"col": "Conditions", "lacks_type": "PlayerRoleIs"},
						{"col": "Conditions", "lacks_type": "PlayerHasStatus"},
						{"col": "Conditions", "lacks_type": "PlayerLifeIndexAtLeast"},
						{"col": "Conditions", "lacks_type": "PlayerAgeAtLeast"},
						{"col": "Effects", "lacks_type": "KillPlayer"},
						{"col": "Effects", "lacks_type": "DeposeRuler"},
						{"col": "Effects", "lacks_type": "PlayerStatDelta"},
						{"col": "Effects", "lacks_type": "GrantPower"}
					]
				},
				{
					"why": "a Lottery row with no weight never fires (guideline 7.5)",
					"when": [{"col": "Trigger", "is": "Lottery"}],
					"then": [{"col": "BaseWeight", "gt": 0}]
				},
				{
					"why": "only a Lottery row has a weight",
					"when": [{"col": "Trigger", "in": ["Standing", "Named"]}],
					"then": [{"col": "BaseWeight", "is": 0}]
				},
				{
					"why": "a row fired by name has no cooldown key",
					"when": [{"col": "Trigger", "is": "Named"}],
					"then": [{"col": "CooldownTicks", "is": 0}]
				},
				{
					"why": "a sign row is told below MinTierToReveal, so there has to be a tier below it",
					"when": [{"col": "SignRow", "set": true}],
					"then": [{"col": "MinTierToReveal", "ge": 2}]
				},
				{
					"why": "the calling's own line that waits for a tier comes with its sign row: the viewers below the window hear the sign (guideline 8.1)",
					"when": [{"col": "LogCategory", "is": "Log.Calling"}, {"col": "MinTierToReveal", "ge": 2}],
					"then": [{"col": "SignRow", "set": true}]
				},
				{
					"why": "a row fired by name is not a slot: the stay condition holds on every tick of its window there (guideline 7.3)",
					"when": [{"col": "Trigger", "is": "Named"}],
					"then": [{"col": "Conditions", "lacks_type": "CivFallenSphereTicksReached"}]
				},
				{
					"why": "a system-subject row lands on a place and the stay condition is about the people: without a cooldown a Standing row would fire once for every settled system in the one slot, otherwise it lands on whichever settled system comes first (guideline 7.3)",
					"when": [{"col": "Subject", "is": "SettledSystem"}],
					"then": [{"col": "Conditions", "lacks_type": "CivFallenSphereTicksReached"}]
				},
				{
					"why": "the research stage fires the found row by name: as a slot row it would also fire in the slots (guideline 5.11)",
					"when": [{"row": "event_book_found"}],
					"then": [{"col": "Trigger", "is": "Named"}]
				},
				{
					"why": "the last-system gate fires the remnant row by name: as a slot row it would also fire in the slots (guideline 4.5)",
					"when": [{"row": "event_grace_remnant"}],
					"then": [{"col": "Trigger", "is": "Named"}]
				},
				{
					"why": "a recorded death waits for the death pipeline of Phase 4b: until then no row records one (guideline 7.4)",
					"then": [{"col": "Effects", "lacks_type": "KillPlayer"}]
				},
				{
					"why": "a grace row names no one (guideline 9.3: NameNotable is not carried by Event.Grace rows)",
					"when": [{"col": "Category", "in": ["Event.Grace.Rescue", "Event.Grace.Remnant", "Event.Grace.Jubilee"]}],
					"then": [{"col": "Effects", "lacks_type": "NameNotable"}]
				}
			]
		},

		"DT_Galaxies": {
			"struct": "GalaxyDef",
			"prefixes": ["gal_"],
			"must_exist": true,
			"columns": {
				"DisplayName": {"kind": "text", "required": true, "forbidden": "verdict"},
				"Kind": {"kind": "tag", "root": "Galaxy.Kind."},
				"LivingWorlds": {"kind": "number", "min": 0, "integer": true},
				"Peoples": {"kind": "number", "min": 0, "integer": true},
				"AIFourthRungCap": {"kind": "number", "min": 0, "integer": true},
				"HomeRadiusShare": {"kind": "number", "min": 0, "max": 1},
				"RadiusLy": {"kind": "number", "min": 0, "integer": true},
				"BridgeTicks": {"kind": "number", "min": 0, "integer": true},
				"StarCountText": {"kind": "text", "hedged": ["약", "추정", "논쟁 중"], "forbidden": "verdict"},
				"DistanceText": {"kind": "text", "required": true, "hedged": ["약", "추정", "논쟁 중"], "forbidden": "verdict"},
				"FeatureText": {"kind": "text", "hedged": ["약", "추정", "논쟁 중"], "forbidden": "verdict"},
				"MapPosition": {"kind": "plain"},
				"StarNameBank": {"kind": "texts", "unique": true, "slots": [], "no_digits": true, "forbidden": "verdict"},
				"CatalogPrefixes": {"kind": "texts", "unique": true, "slots": [], "no_digits": true, "forbidden": "verdict"},
				"CatalogStems": {"kind": "texts", "unique": true, "slots": [], "no_digits": true, "forbidden": "verdict"},
				"PeopleStems": {"kind": "texts", "unique": true, "slots": [], "no_digits": true, "forbidden": "verdict"}
			},
			"unique": [
				{"cols": ["DisplayName"], "why": "the universe level labels every galaxy with its name: two rows of one name would read as one galaxy (guideline 5.11, 6.4)"},
				{"cols": ["MapPosition"], "why": "two galaxies never stand on one place - the home holds (0,0), so a row left there has no place yet (guideline 5.11, 7.3)"}
			],
			"rules": [
				{
					"why": "a galaxy other than the home holds no peoples, no brake, no home share and no name pools (guideline 5.11 '고향이 아닌 행의 이 네 값은 0')",
					"when": [{"col": "LivingWorlds", "is": 0}],
					"then": [{"col": "Peoples", "is": 0}, {"col": "AIFourthRungCap", "is": 0}, {"col": "HomeRadiusShare", "is": 0}, {"col": "StarNameBank", "max_len": 0}, {"col": "CatalogPrefixes", "max_len": 0}, {"col": "CatalogStems", "max_len": 0}]
				}
			]
		},

		"DT_Transcendents": {
			"struct": "TranscendentDef",
			"prefixes": ["trans_"],
			"must_exist": true,
			"required_rows": ["trans_silence"],
			"columns": {
				"Doctrine": {"kind": "tag", "root": "Doctrine."},
				"Allegiance": {"kind": "tag", "root": "Realm."},
				"CounterfeitOf": {"kind": "tag", "root": "Truth.", "optional": true},
				"Title": {"kind": "text", "slots": [], "no_digits": true, "forbidden": "verdict"},
				"Lure": {"kind": "text"},
				"Tier": {"kind": "enum", "enum": "EAscensionTier"},
				"Depth": {"kind": "number", "min": 0, "max": 1},
				"InitialInfluencedSystems": {"kind": "number", "min": 0, "max": 1, "integer": true},
				"MaxInfluencedSystems": {"kind": "number", "min": 0, "integer": true},
				"SpawnWeight": {"kind": "number", "min": 0},
				"EventWeightModifiers": {"kind": "tag_map", "root": "Event.", "min": 0},
				"PressureEffectsPerTick": {"kind": "effects", "per_tick": true},
				"VoiceTemplates": {"kind": "texts"},
				"ClaimTemplates": {"kind": "texts"}
			},
			"unique": [
				{"cols": ["Doctrine"], "why": "one transcendent per doctrine in a run (guideline 4.2)"}
			],
			"rules": [
				{
					"why": "the fixed place of the roster belongs to a fallen silence",
					"when": [{"row": "trans_silence"}],
					"then": [{"col": "Allegiance", "is": "Realm.Abyssal"}, {"col": "Doctrine", "is": "Doctrine.Silence"}]
				},
				{
					"why": "a transcendent stands on tier 3 or 4 (guideline 4.2: no fallen one on tier 5)",
					"then": [{"col": "Tier", "in": ["Tier3_Causal", "Tier4_Transcendent"]}]
				},
				{
					"why": "a celestial transcendent has no instance: no sphere, no pressure, no roster weight",
					"when": [{"col": "Allegiance", "is": "Realm.Celestial"}],
					"then": [
						{"col": "SpawnWeight", "is": 0},
						{"col": "InitialInfluencedSystems", "is": 0},
						{"col": "MaxInfluencedSystems", "is": 0},
						{"col": "PressureEffectsPerTick", "max_len": 0},
						{"col": "EventWeightModifiers", "max_len": 0}
					]
				},
				{
					"why": "the roster of NewGalaxy draws fallen rows only",
					"when": [{"col": "Allegiance", "is": "Realm.Independent"}],
					"then": [{"col": "SpawnWeight", "is": 0}]
				},
				{
					"why": "a fallen one is named by its title, never a name: the spiritual sight's line and tooltip and the log's {Transcendent} slot read it (guideline 4.2, 6.4, 8.2)",
					"when": [{"col": "Allegiance", "is": "Realm.Abyssal"}],
					"then": [{"col": "Title", "set": true}]
				}
			]
		},

		"DT_Hazards": {
			"struct": "HazardDef",
			"prefixes": ["crisis_"],
			"must_exist": true,
			"columns": {
				"HazardTag": {"kind": "tag", "root": "Hazard."},
				"SourceDoctrine": {"kind": "tag", "root": ["Doctrine.Silence", "Doctrine.Assimilation", "Doctrine.Zeal", "Doctrine.Recurrence"], "optional": true},
				"DisplayName": {"kind": "text", "required": true, "slots": [], "forbidden": "verdict"},
				"CountdownTicks": {"kind": "number", "min": 1, "integer": true},
				"SpawnRule": {"kind": "enum", "enum": "ECosmicHazardSpawn"},
				"SpawnChancePerTick": {"kind": "number", "min": 0, "max": 1},
				"SpawnConditions": {"kind": "conditions"},
				"OnExpireEffects": {"kind": "effects"},
				"BranchChance": {"kind": "number", "min": 0, "max": 1},
				"OnExpireBranchEffects": {"kind": "effects"},
				"OnExpireNeighbourEffects": {"kind": "effects"},
				"OnResolveEffects": {"kind": "effects"},
				"RulerResolutions": {"kind": "rows", "tables": ["DT_Megaprojects", "DT_Encounters"], "unique": true},
				"WandererResolutions": {"kind": "rows", "tables": ["DT_Encounters"], "unique": true},
				"LogCategory": {"kind": "tag", "root": ["Log.Crisis"]},
				"Severity": {"kind": "number", "min": 0, "max": 2, "integer": true},
				"OutbreakTemplates": {"kind": "texts", "slots": ["Civ", "System", "Hazard"], "forbidden": "verdict"},
				"ExpireTemplates": {"kind": "texts", "slots": ["Civ", "System", "Hazard"], "forbidden": "verdict"},
				"ResolveTemplates": {"kind": "texts", "slots": ["Civ", "System", "Hazard"], "forbidden": "verdict"},
				"OutbreakRow": {"kind": "row", "table": "DT_Events", "optional": true, "target": [{"col": "Trigger", "is": "Named"}, {"col": "Subject", "is": "SettledSystem"}, {"col": "Effects", "lacks_type": "ResolveHazard"}]}
			},
			"unique": [
				{"cols": ["HazardTag"], "why": "a system holds the tag and the code finds the row by it (guideline 7.3)"}
			],
			"rules": [
				{
					"why": "the claim is placed by the claim rule alone, which holds Law.Remnant (guideline 4.2)",
					"when": [{"col": "HazardTag", "is": "Hazard.Claim"}],
					"then": [{"col": "SpawnRule", "is": "ClaimRule"}]
				},
				{
					"why": "the claim rule places the claim and nothing else (guideline 4.2)",
					"when": [{"col": "SpawnRule", "is": "ClaimRule"}],
					"then": [{"col": "HazardTag", "is": "Hazard.Claim"}]
				},
				{
					"why": "a rebellion is the discontent of a people in its capital, not a draw (guideline 4.1)",
					"when": [{"col": "HazardTag", "is": "Hazard.Rebellion"}],
					"then": [{"col": "SpawnRule", "is": "Capital"}]
				},
				{
					"why": "a Draw row is drawn every tick: a chance of 0 is a slip, and a hazard that only an effect or a hook places will have a spawn rule of its own (guideline 7.3, Phase 4)",
					"when": [{"col": "SpawnRule", "is": "Draw"}],
					"then": [{"col": "SpawnChancePerTick", "gt": 0}]
				},
				{
					"why": "only a drawn hazard has a chance: the capital rule and the claim rule draw nothing (guideline 7.4)",
					"when": [{"col": "SpawnRule", "in": ["Capital", "ClaimRule"]}],
					"then": [{"col": "SpawnChancePerTick", "is": 0}]
				},
				{
					"why": "a branch is a chance and the effects it takes instead (guideline 4.1)",
					"when": [{"col": "BranchChance", "gt": 0}],
					"then": [{"col": "OnExpireBranchEffects", "min_len": 1}]
				},
				{
					"why": "branch effects without a chance are never applied (guideline 4.1)",
					"when": [{"col": "BranchChance", "is": 0}],
					"then": [{"col": "OnExpireBranchEffects", "max_len": 0}]
				},
				{
					"why": "a recorded death waits for the death pipeline of Phase 4b: until then no row records one (guideline 7.4)",
					"then": [
						{"col": "OnExpireEffects", "lacks_type": "KillPlayer"},
						{"col": "OnExpireBranchEffects", "lacks_type": "KillPlayer"},
						{"col": "OnExpireNeighbourEffects", "lacks_type": "KillPlayer"},
						{"col": "OnResolveEffects", "lacks_type": "KillPlayer"}
					]
				},
				{
					"why": "the leader of a cult has no name (guideline 4.1)",
					"when": [{"col": "HazardTag", "is": "Hazard.Cult"}],
					"then": [
						{"col": "OnExpireEffects", "lacks_type": "NameNotable"},
						{"col": "OnExpireBranchEffects", "lacks_type": "NameNotable"},
						{"col": "OnExpireNeighbourEffects", "lacks_type": "NameNotable"},
						{"col": "OnResolveEffects", "lacks_type": "NameNotable"},
						{"col": "OutbreakRow", "set": false}
					]
				},
				{
					"why": "the stage reads the spawn conditions on every tick, and the stay condition holds on every tick of its window, not in one slot (guideline 7.3)",
					"then": [{"col": "SpawnConditions", "lacks_type": "CivFallenSphereTicksReached"}]
				},
				{
					"why": "only stage code behind the last-system gate takes a system: an expiry hands nothing over, and neither does a resolution, which an expiry may run on a neighbour (guideline 4.5, 16 #53 (1))",
					"then": [
						{"col": "OnExpireEffects", "lacks_type": "TransferSystem"},
						{"col": "OnExpireBranchEffects", "lacks_type": "TransferSystem"},
						{"col": "OnExpireNeighbourEffects", "lacks_type": "TransferSystem"},
						{"col": "OnResolveEffects", "lacks_type": "TransferSystem"}
					]
				},
				{
					"why": "a resolution or an expiry does not resolve again on its own system: a row that resolves what it places would never end (guideline 7.3)",
					"then": [
						{"col": "OnResolveEffects", "lacks_type": "ResolveHazard"},
						{"col": "OnExpireEffects", "lacks_type": "ResolveHazard"},
						{"col": "OnExpireBranchEffects", "lacks_type": "ResolveHazard"}
					]
				}
			]
		},
		"DT_Megaprojects": {
			"struct": "MegaprojectDef",
			"prefixes": ["project_"],
			"required_rows": ["project_settle"],
			"must_exist": true,
			"columns": {
				"DisplayName": {"kind": "text", "required": true, "slots": [], "forbidden": "verdict"},
				"RequiredTier": {"kind": "enum", "enum": "EAscensionTier"},
				"CostPerTick": {"kind": "pool", "min": 0},
				"RequiredProgress": {"kind": "number", "min": 1},
				"CompleteTemplates": {"kind": "texts", "min": 3, "slots": ["Civ", "System", "Project"], "forbidden": "verdict"}
			}
		},
		"DT_Feats": {
			"struct": "AscensionFeatDef",
			"prefixes": ["feat_"],
			"must_exist": true,
			"columns": {
				"Title": {"kind": "text", "required": true, "slots": [], "forbidden": "verdict"},
				"MythicNarrative": {"kind": "text", "required": true, "slots": [], "forbidden": "verdict"},
				"RequiredTier": {"kind": "enum", "enum": "EAscensionTier"},
				"TargetTier": {"kind": "enum", "enum": "EAscensionTier"},
				"Path": {"kind": "enum", "enum": "EPlayerRole"},
				"CompletionConditions": {"kind": "conditions"},
				"AscensionCost": {"kind": "effects"},
				"GrantedPowers": {"kind": "tags", "root": ["Power.", "Way."]},
				"DedicationBank": {"kind": "tag", "root": "Faith.Bank.", "optional": true},
				"FX": {"kind": "plain"},
				"Sound": {"kind": "plain"},
				"LogTemplates": {"kind": "texts", "min": 3, "slots": ["Civ", "HomeSystem"], "forbidden": "verdict"}
			},
			"rules": [
				{
					"why": "the wanderer's feats are judged from Phase 4, with their first row: until then no row walks that path (guideline 3.2, 7.5)",
					"then": [{"col": "Path", "is": "Ruler"}]
				},
				{
					"why": "a feat lifts its people one rung: from the first to the second (guideline 3.2; the judgment does not judge another row)",
					"when": [{"col": "RequiredTier", "is": "Tier1_Planetary"}],
					"then": [{"col": "TargetTier", "is": "Tier2_Stellar"}]
				},
				{
					"why": "a feat lifts its people one rung: from the second to the third (guideline 3.2; the judgment does not judge another row)",
					"when": [{"col": "RequiredTier", "is": "Tier2_Stellar"}],
					"then": [{"col": "TargetTier", "is": "Tier3_Causal"}]
				},
				{
					"why": "a feat lifts its people one rung: from the third to the fourth (guideline 3.2; the judgment does not judge another row)",
					"when": [{"col": "RequiredTier", "is": "Tier3_Causal"}],
					"then": [{"col": "TargetTier", "is": "Tier4_Transcendent"}]
				},
				{
					"why": "a feat lifts its people one rung: from the fourth to the fifth (guideline 3.2; the judgment does not judge another row)",
					"when": [{"col": "RequiredTier", "is": "Tier4_Transcendent"}],
					"then": [{"col": "TargetTier", "is": "Tier5_EternalOrder"}]
				},
				{
					"why": "the fifth rung is the last: no feat climbs from it (guideline 3.2)",
					"then": [{"col": "RequiredTier", "in": ["Tier1_Planetary", "Tier2_Stellar", "Tier3_Causal", "Tier4_Transcendent"]}]
				},
				{
					"why": "no people climbs without a deed: a feat holds one condition or more (guideline 3.2; the judgment does not judge a row without one)",
					"then": [{"col": "CompletionConditions", "min_len": 1}]
				},
				{
					"why": "a ruler feat row judges every people, the AI's too (guideline 4.3): its conditions do not read the vessel, and its price records no role effect and touches no vessel (a recorded death also waits for the death pipeline of Phase 4b). How a vessel condition of a T4->T5 row reads for the AI is decided with that row (guideline 16 #1); a wanderer's feat is judged on the vessel and gets its own rules with its first row (guideline 16 #28)",
					"when": [{"col": "Path", "is": "Ruler"}],
					"then": [
						{"col": "CompletionConditions", "lacks_type": "PlayerTierAtLeast"},
						{"col": "CompletionConditions", "lacks_type": "PlayerInSystemWithHazard"},
						{"col": "CompletionConditions", "lacks_type": "PlayerStatAtLeast"},
						{"col": "CompletionConditions", "lacks_type": "PlayerHasRelic"},
						{"col": "CompletionConditions", "lacks_type": "PlayerRoleIs"},
						{"col": "CompletionConditions", "lacks_type": "PlayerHasStatus"},
						{"col": "CompletionConditions", "lacks_type": "PlayerLifeIndexAtLeast"},
						{"col": "CompletionConditions", "lacks_type": "PlayerAgeAtLeast"},
						{"col": "AscensionCost", "lacks_type": "KillPlayer"},
						{"col": "AscensionCost", "lacks_type": "DeposeRuler"},
						{"col": "AscensionCost", "lacks_type": "PlayerStatDelta"},
						{"col": "AscensionCost", "lacks_type": "GrantPower"}
					]
				}
			]
		},
		"DT_Encounters": {
			"struct": "EncounterDef",
			"prefixes": ["enc_", "petition_"],
			"must_exist": true,
			"columns": {
				"Title": {"kind": "text", "required": true, "slots": ["Civ", "System", "Hazard", "Rebel"], "no_digits": true, "forbidden": "verdict"},
				"Body": {"kind": "text", "slots": ["Civ", "System", "Hazard", "Rebel"], "no_digits": true, "forbidden": "verdict"},
				"Conditions": {"kind": "conditions"},
				"BaseWeight": {"kind": "number", "min": 0},
				"Choices": {
					"kind": "structs",
					"len_in": [2, 3],
					"columns": {
						"Label": {"kind": "text", "required": true, "slots": ["Civ", "System", "Hazard", "Rebel"], "no_digits": true, "forbidden": "verdict"},
						"CheckStat": {"kind": "enum", "enum": "ECosmicCheckStat"},
						"Difficulty": {"kind": "number", "min": 0, "max": 16, "integer": true},
						"Cost": {"kind": "pool", "min": 0},
						"OnSuccess": {"kind": "effects"},
						"OnFailure": {"kind": "effects"},
						"SuccessText": {"kind": "text", "required": true, "slots": ["Civ", "System", "Hazard", "Rebel"], "no_digits": true, "forbidden": "verdict"},
						"FailureText": {"kind": "text", "slots": ["Civ", "System", "Hazard", "Rebel"], "no_digits": true, "forbidden": "verdict"},
						"NextEncounter": {"kind": "row", "table": "DT_Encounters", "optional": true}
					}
				},
				"Illustration": {"kind": "plain"},
				"Trigger": {"kind": "enum", "enum": "ECosmicEventTrigger"},
				"Subject": {"kind": "enum", "enum": "ECosmicEventSubject"},
				"VoiceBodies": {"kind": "texts", "len_in": [0, 2], "slots": ["Civ", "System", "Hazard", "Rebel"], "no_digits": true, "forbidden": "verdict"}
			},
			"rules": [
				{
					"why": "a petition is put before a ruler: every row carries the condition PlayerRoleIs (guideline 5.10)",
					"then": [{"col": "Conditions", "has_type": "PlayerRoleIs"}]
				},
				{
					"why": "a card records no death (the death pipeline of Phase 4b) and runs no per-tick effect; the effects that grant, place, take or name wait for the rows that use them (guideline 5.10, 7.4)",
					"then": [
						{"col": "Choices.OnSuccess", "lacks_type": "KillPlayer"},
						{"col": "Choices.OnFailure", "lacks_type": "KillPlayer"},
						{"col": "Choices.OnSuccess", "lacks_type": "MultiplyIncome"},
						{"col": "Choices.OnFailure", "lacks_type": "MultiplyIncome"},
						{"col": "Choices.OnSuccess", "lacks_type": "GrantPower"},
						{"col": "Choices.OnFailure", "lacks_type": "GrantPower"},
						{"col": "Choices.OnSuccess", "lacks_type": "SpawnHazard"},
						{"col": "Choices.OnFailure", "lacks_type": "SpawnHazard"},
						{"col": "Choices.OnSuccess", "lacks_type": "TransferSystem"},
						{"col": "Choices.OnFailure", "lacks_type": "TransferSystem"},
						{"col": "Choices.OnSuccess", "lacks_type": "NameNotable"},
						{"col": "Choices.OnFailure", "lacks_type": "NameNotable"}
					]
				},
				{
					"why": "the subject system of a card is the system it names: a Civilization row is about the people alone and names no system (guideline 8.1)",
					"when": [{"col": "Subject", "is": "Civilization"}],
					"then": [
						{"col": "Title", "slots_in": ["Civ", "Hazard", "Rebel"]},
						{"col": "Body", "slots_in": ["Civ", "Hazard", "Rebel"]},
						{"col": "VoiceBodies", "slots_in": ["Civ", "Hazard", "Rebel"]},
						{"col": "Choices.Label", "slots_in": ["Civ", "Hazard", "Rebel"]},
						{"col": "Choices.SuccessText", "slots_in": ["Civ", "Hazard", "Rebel"]},
						{"col": "Choices.FailureText", "slots_in": ["Civ", "Hazard", "Rebel"]}
					]
				},
				{
					"why": "a row the knowing stage puts is picked by its weight among the rows of its moment (guideline 5.10)",
					"when": [{"col": "Trigger", "in": ["Lottery", "Standing"]}],
					"then": [{"col": "BaseWeight", "gt": 0}]
				},
				{
					"why": "a row put by name (the next card of a chain) is never picked: it has no weight",
					"when": [{"col": "Trigger", "is": "Named"}],
					"then": [{"col": "BaseWeight", "is": 0}]
				},
				{
					"why": "a card without voices speaks through its Body",
					"when": [{"col": "VoiceBodies", "max_len": 0}],
					"then": [{"col": "Body", "set": true}]
				},
				{
					"why": "a voiced card speaks through its two voices, the council's and the elders' of the congregation, and its Body stays empty (guideline 5.10)",
					"when": [{"col": "VoiceBodies", "min_len": 1}],
					"then": [{"col": "Body", "set": false}]
				}
			]
		}
	},

